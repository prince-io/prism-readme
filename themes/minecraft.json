      "lines": [
        { "x": 88, "size": 16, "weight": 700, "text": "Hey, I'm Prince! I build full-stack apps and explore the future of AI." },
        { "x": 88, "size": 16, "weight": 700, "text": "I love building things end-to-end - from the first line of code to a" },
        { "x": 88, "size": 16, "weight": 700, "text": "working product people actually use. Lately my curiosity is pointed at" },
        { "x": 88, "size": 16, "weight": 700, "text": "the AI space, taking these tools beyond flashy demos into things that" },
        { "x": 88, "size": 16, "weight": 700, "text": "genuinely work. I learn best by building - if I'm curious, I've probably" },
        { "x": 88, "size": 16, "weight": 700, "text": "already started coding it. Check out my focus areas below." }
